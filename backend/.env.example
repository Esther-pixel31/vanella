# M-Pesa (Safaricom Daraja). Get the key and secret from your app at
# https://developer.safaricom.co.ke. The shortcode and passkey below are
# Safaricom's public sandbox test values.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://example.com/api/payments/mpesa/callback
MPESA_SANDBOX_AMOUNT=1

# PayBill per branch (JSON, keyed by branch name) and passkey per PayBill.
# In the sandbox both branches use the test PayBill 174379.
MPESA_BRANCH_SHORTCODES={"Bamburi": "174379", "Mombasa Town CBD": "174379"}
